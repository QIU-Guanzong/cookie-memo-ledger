{
  "name": "cookie-memo-ledger",
  "version": "0.1.0",
  "description": "A static-first Cookie Chain memo ledger with explicit Nightly transaction states.",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "check": "pnpm test && pnpm build"
  },
  "keywords": [
    "cookie-chain",
    "solana",
    "nightly-wallet",
    "capp"
  ],
  "license": "MIT",
  "dependencies": {
    "@solana/web3.js": "1.98.4"
  },
  "devDependencies": {
    "vite": "7.1.7"
  },
  "pnpm": {
    "overrides": {
      "jayson>uuid": "11.1.1",
      "jayson>stream-json": "3.5.0"
    }
  }
}
